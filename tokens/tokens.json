{
  "$comment": "Single source of design tokens. Run `dart run tool/generate_tokens.dart` in packages/design_system after editing.",
  "color": {
    "light": {
      "background": "#FAFAF9",
      "surface": "#FFFFFF",
      "surfaceMuted": "#F1F0EE",
